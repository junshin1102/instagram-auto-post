# Instagram Graph API
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_access_token

# Anthropic (caption generation)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Cloudinary (image hosting — Graph API needs a public URL for each image)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# YouTube Data API (Reelsと同じ動画をYouTube Shortsにも投稿。任意)
# 3つすべて揃っている場合のみ実行される。1つでも欠けると
# エラーを出さずにスキップするため、設定漏れに気づきにくい点に注意。
# refresh token の取り直しには OAuth 認証のやり直しが必要。
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# LINE Messaging API (投稿の成功・失敗をLINEに通知。任意 — 未設定なら通知はスキップされる)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# 投稿の実行記録(state/heartbeat.json)をGitHubにも反映するか。
# true にすると、投稿が動いているかをGitHub側から確認できるようになる。
# ローカル実行時のみ有効(GitHub Actions上では常に反映される)。
SYNC_STATE_TO_GITHUB=false

# --- 以下は任意。未設定ならコード内の既定値が使われる ---

# 投稿対象を取得するヤフオク出品者ページ。出品アカウントを変えた場合のみ設定する。
# 既定: https://auctions.yahoo.co.jp/seller/7F3TQFS83hRevxWX9wK4z2ZvPzj3t?user_type=c
# YAHOO_SELLER_URL=

# Instagram Graph API のバージョン。既定: v21.0
# GRAPH_API_VERSION=
